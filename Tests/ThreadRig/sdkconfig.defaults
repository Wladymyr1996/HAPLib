# Project defaults. sdkconfig itself is generated and gitignored, so anything
# the rig depends on belongs here.

CONFIG_IDF_TARGET="esp32c6"

# The C6FH8 has 8 MB of in-package flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# The console is the board's USB port, for the `hap` and `ot` commands.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Thread: FTD with the native 802.15.4 radio, and the CLI that `ot <line>` feeds.
# Joining is done by the rig with a fixed dataset, so nothing here auto-starts.
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_BORDER_ROUTER=n
CONFIG_OPENTHREAD_CLI=y
CONFIG_OPENTHREAD_CONSOLE_ENABLE=y
CONFIG_OPENTHREAD_CONSOLE_TYPE_USB_SERIAL_JTAG=y
CONFIG_OPENTHREAD_TASK_SIZE=10240
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
